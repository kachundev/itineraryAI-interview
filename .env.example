# Copy to .env for local live calls. Never commit a real key.
XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-non-reasoning
PORT=8787
# Abort upstream generate after this many ms (default 45000)
GENERATE_TIMEOUT_MS=45000
# When set to 1 and XAI_API_KEY is empty, POST /generate returns fixtures/kyoto-3day-response.json
# (handy for demos without a key; npm test does not need this)
FIXTURE_MODE=0
